# Base image سبک و امن
FROM python:3.11

# Set working directory
WORKDIR /app

# RUN pip config --user set global.index https://mirror-pypi.runflare.com/simple
# RUN pip config --user set global.index-url https://mirror-pypi.runflare.com/simple
# RUN pip config --user set global.trusted-host mirror-pypi.runflare.com
RUN export PIP_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple

# نصب وابستگی‌ها
# COPY ./alembic.ini /app/alembic.ini
# COPY ./alembic /app/alembic
COPY ./requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser
RUN mkdir -p /app/uploads/avatars && chown -R appuser:appgroup /app/uploads
USER appuser

# کپی سورس کد
COPY ./src /app/src

# نصب Gunicorn برای اجرا در پروداکشن
RUN pip install gunicorn uvicorn

# expose پورت مورد نظر
EXPOSE 8000

# دستور شروع اپ با Gunicorn
CMD ["gunicorn", "-k", "uvicorn.workers.UvicornWorker", "src.main:app", "--bind", "0.0.0.0:8000", "--workers", "4", "--log-level", "info"]
# CMD ["sh", "-c", "alembic upgrade head && gunicorn -k uvicorn.workers.UvicornWorker src.main:app --bind 0.0.0.0:8000 --workers 4 --log-level info"]


